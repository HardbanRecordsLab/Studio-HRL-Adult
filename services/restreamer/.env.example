# Shared secret between the Next.js app and this service (>= 16 chars, e.g. `openssl rand -hex 32`).
RESTREAMER_TOKEN=
# Public domain for HTTPS (control API + WHIP + HLS), e.g. live.example.com
LIVE_DOMAIN=
# Public IPv4 of this server, advertised to browsers for WebRTC media.
LIVE_PUBLIC_IP=
# copy = pass the camera's H.264 through; transcode = re-encode (use if a platform rejects the stream).
VIDEO_MODE=copy
